{
  "name": "@brpaz/bruno-openapi-sync",
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Sync an OpenAPI spec into a Bruno collection (OpenCollection YAML) without clobbering user-owned content.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "bruno-openapi-sync": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "keywords": [
    "bruno",
    "openapi",
    "swagger",
    "sync",
    "cli"
  ],
  "author": "brpaz <bruno@brunopaz.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brpaz/bruno-openapi-sync.git"
  },
  "homepage": "https://github.com/brpaz/bruno-openapi-sync#readme",
  "bugs": {
    "url": "https://github.com/brpaz/bruno-openapi-sync/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.3",
    "openapi-types": "^12.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@opencollection/types": "^0.12.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
